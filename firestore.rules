rules_version = '2';

// JobFolder — Firestore security rules.
// Paste these into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is anyone with a document at admins/{their-uid}.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Jobs: posted by admins only. The public may read `open` roles; admins
    // see and manage everything.
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'open' || isAdmin();
      allow write: if isAdmin();
    }

    // Submissions: open applications — anyone may submit a candidate (no login
    // required). We require the core contact fields so every candidate is
    // reachable. Signed-in recruiters may still read their own; admins screen
    // and manage everything.
    match /submissions/{subId} {
      allow create: if request.resource.data.candidateName is string
        && request.resource.data.candidateName.size() > 0
        && request.resource.data.candidateEmail is string
        && request.resource.data.candidateEmail.size() > 0
        && request.resource.data.candidatePhone is string
        && request.resource.data.candidatePhone.size() > 0
        && request.resource.data.cvUrl is string
        && request.resource.data.status == 'submitted';
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.recruiterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Recruiter profiles. A user owns their own doc; admins may read them all
    // (so the console can list every recruiter).
    match /users/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null
        && request.auth.uid == uid;
      allow delete: if false;
    }

    // Contact enquiries: anyone may send one; only admins can read them.
    match /messages/{msgId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    // Site settings (e.g. the editable job-category list). Public read so the
    // job board + posting form can load it; only admins can change it.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin allow-list.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // TEMP BOOTSTRAP — lets the /setup page create your first admin.
      // After your admin exists, change this line back to `if false;`
      // and re-publish, then delete the setup page.
      allow create: if request.auth != null && request.auth.uid == uid;

      allow update, delete: if false;
    }
  }
}
